questions = (
    "Which of the following is not a fruit?  ",
    "What color is at the top of a rainbow? :  ",
    "How many bones are in the human body?  ",
    "Which country is in Asia:   ",
    "What is the first layer in the atmosphere:  ")

options = (
    ("A. Apple", "B. Cabbage", "C. Mango", "D. Pineapple"),
    ("A. Purple", "B. Yellow", "C. Green", "D. Red"),
    ("A. 206", "B. 207", "C. 208", "D. 209"),
    ("A. Portugal", "B. Japan", "C. America", "D. United Arab Emirates"),
    ("A. Troposphere", "B. Thermosphere ", "C. Space ", "D. Mesosphere", "E. Exosphere"))

answers = ("B", "D", "A", "B", "A")  
validanswers = ("A", "B", "C", "D")
guesses = []  
score = 0  

for index, question in enumerate(questions):
    print("=======================================")
    print(question)
    for option in options[index]:
        print(option)

    while True:     # 🛡️ Input validation loop
        guess = input("Enter your answer (letter only): ").upper()
        if guess in validanswers[:len(options[index])]:
            break   # valid input, exit the loop
        else:
            print("Invalid input. Please enter only one of the letters:", 
                  ", ".join(validanswers[:len(options[index])]))

    if guess == answers[index]:
        print("CORRECT!")
        score += 1
    else:
        print("INCORRECT!")
        print(f"The correct answer is {answers[index]}")

print("=========================")
print("=========RESULTS=========")
print("=========================")

print("Your answers: ", end="")
for guess in guesses:
    print(guess, end=" ")
print()

print("Correct answers: ", end="")
for answer in answers:
    print(answer, end=" ")
print()

print(f"You scored {score}/{len(questions)}!")
percentage = score / len(answers) * 100
print(f"Your percentage is: {percentage:.2f}%")
